# Database
# Neon + Prisma (recommended)
# DATABASE_URL: pooled connection (use Neon "Pooled connection" string)
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/resumeai?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL: direct connection (use Neon "Direct connection" string)
DIRECT_URL="postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/resumeai?sslmode=require"

# Authentication (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
ROOT_ADMIN_EMAIL="admin@example.com"
ROOT_ADMIN_PASSWORD="change-this-now"
# Dev-only QA credential password for:
# qa-free@resumeai.local / qa-pro@resumeai.local / qa-premium@resumeai.local
QA_TEST_PASSWORD="change-this-qa-password"
# Admin quick-switch page (dev): http://localhost:3000/admin

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Magic Link Email (Resend)
EMAIL_FROM="noreply@resumeai.com"

# AI Provider Settings
# Set to "true" to enable, "false" to disable
USE_ANTHROPIC="true"
USE_OPENAI="false"

# Anthropic API (Claude)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"

# OpenAI API (fallback)
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Stripe
STRIPE_SECRET_KEY="sk_test_or_live_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_or_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Stripe Price IDs
STRIPE_PRO_MONTHLY_PRICE="price_xxx"
STRIPE_PRO_ANNUAL_PRICE="price_xxx"
STRIPE_PREMIUM_MONTHLY_PRICE="price_xxx"
STRIPE_PREMIUM_ANNUAL_PRICE="price_xxx"

# PayPal
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox"

# PayPal Plan IDs
PAYPAL_PRO_MONTHLY_PLAN="P-xxx"
PAYPAL_PRO_ANNUAL_PLAN="P-xxx"
PAYPAL_PREMIUM_MONTHLY_PLAN="P-xxx"
PAYPAL_PREMIUM_ANNUAL_PLAN="P-xxx"

# Email (Resend)
RESEND_API_KEY="re_your-resend-api-key"
FROM_EMAIL="noreply@resumeai.com"

# File Storage (Cloudflare R2 or AWS S3)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# App Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SEO + Analytics
# Google Analytics 4 Measurement ID (example: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Meta Pixel ID (example: 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=""
# Search console ownership verification
GOOGLE_SITE_VERIFICATION=""
# Bing webmaster verification (optional)
BING_SITE_VERIFICATION=""

# Synthetic data seeding (optional, local QA/automation)
SYNTHETIC_USERS_PER_PLAN="3"
SYNTHETIC_RESUMES_FREE="2"
SYNTHETIC_RESUMES_PRO="4"
SYNTHETIC_RESUMES_PREMIUM="6"
SYNTHETIC_APPS_PER_USER="8"
SYNTHETIC_EMAIL_PREFIX="synthetic"
SYNTHETIC_EMAIL_DOMAIN="synthetic.resumeai.local"
SYNTHETIC_TAG="SYNTH"
